# Copy values into your process environment; Django does not auto-load this file.
LAB_LOCAL_DEV=1
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
LAB_SECRET_KEY=
LAB_DB=sqlite
# PostgreSQL: set LAB_DB=postgres, and all five values below.
PGDATABASE=hardware_lab
PGUSER=hardware_lab
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
